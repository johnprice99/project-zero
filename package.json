{
  "name": "project-zero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json && prettier --check . && npm test",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "tauri": "tauri",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "node scripts/release.mjs",
    "update-key": "tauri signer generate -w ~/.config/project-zero/update-key"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
