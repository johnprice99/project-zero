{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Zero",
  "version": "../package.json",
  "identifier": "com.johnprice.projectzero",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "target/web"
  },
  "app": {
    "windows": [
      {
        "title": "Project Zero",
        "width": 1380,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5MTYzQjcxOEFDMjk2NTMKUldSVGxzS0tjVHNXZVRJVnhJSkQxQmR5TlhtYTh1clVuMmJUV0FpLzZYSEVDQVIvZFJwc1d3YkgK",
      "endpoints": [
        "https://github.com/johnprice99/project-zero/releases/latest/download/latest.json"
      ]
    }
  }
}
